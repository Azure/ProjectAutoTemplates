{
  "kind": "AutoTemplate",
  "apiVersion": "v1",
  "metadata": {
    "id": "scenario-05-sprint-iteration-planning",
    "name": "Review Azure DevOps Boards sprint and backlog work items every hour",
    "description": "Every hour, list a team's iterations, retrieve work item references for a selected iteration, and list work item references at a configured backlog level. Configure the Boards connection, project, team, iteration, and backlog level before publishing.",
    "category": [
      "engineering",
      "data"
    ],
    "tags": [
      "Azure DevOps",
      "Boards",
      "Sprints",
      "Iterations",
      "Backlog",
      "Planning"
    ],
    "author": "Microsoft",
    "source": "builtin",
    "featuredConnectors": [
      "/serviceProviders/ado-boards"
    ]
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Hour",
            "interval": 1
          }
        }
      },
      "actions": {
        "List_iterations": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-boards",
              "operationId": "iterations-list",
              "connectionName": "ado-boards_#workflowname#"
            },
            "parameters": {
              "project": "",
              "team": ""
            }
          },
          "runAfter": {}
        },
        "List_iteration_work_items": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-boards",
              "operationId": "iterations-get-iteration-work-items",
              "connectionName": "ado-boards_#workflowname#"
            },
            "parameters": {
              "project": "",
              "team": "",
              "iterationId": ""
            }
          },
          "runAfter": {
            "List_iterations": [
              "Succeeded"
            ]
          }
        },
        "List_backlog_level_work_items": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-boards",
              "operationId": "backlogs-get-backlog-level-work-items",
              "connectionName": "ado-boards_#workflowname#"
            },
            "parameters": {
              "project": "",
              "team": "",
              "backlogId": "Microsoft.TaskCategory"
            }
          },
          "runAfter": {
            "List_iteration_work_items": [
              "Succeeded"
            ]
          }
        }
      },
      "contentVersion": "1.0.0.0"
    }
  },
  "trigger": {
    "name": "Recurrence",
    "outputs": {
      "method": "POST",
      "headers": {},
      "queries": {},
      "body": null
    }
  },
