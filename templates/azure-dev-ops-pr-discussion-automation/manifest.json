{
  "kind": "AutoTemplate",
  "apiVersion": "v1",
  "metadata": {
    "id": "azure-dev-ops-pr-discussion-automation",
    "name": "Azure DevOps PR Discussion Automation",
    "description": "Create a PR discussion, add and edit replies, and manage comment likes. Delete the test reply and abandon the PR afterward.",
    "category": [
      "engineering",
      "communication"
    ],
    "tags": [
      "Azure DevOps",
      "Repos",
      "Pull requests"
    ],
    "author": "Microsoft",
    "source": "builtin",
    "featuredConnectors": [
      "/serviceProviders/ado-repos",
      "connectionProviders/request"
    ]
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "triggers": {
        "When_an_HTTP_request_is_received": {
          "type": "Request",
          "kind": "Http",
          "inputs": {},
          "description": "No request body is required. Keep connector mocks enabled for draft testing. Before a live run, bind the Azure DevOps Repos connection and configure all resource selections in the actions."
        }
      },
      "actions": {
        "Create_PR": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-requests-create",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "body/sourceRefName": "",
              "body/targetRefName": "",
              "body/title": "[example] S5 bot commenting",
              "body/description": "Automated fixture PR for ADO Repos scenario 5.",
              "supportsIterations": true
            }
          },
          "runAfter": {}
        },
        "Create_thread": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-threads-create",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "body/comments": [
                {
                  "parentCommentId": 0,
                  "content": "example: bot thread root",
                  "commentType": "text"
                }
              ],
              "body/status": "active"
            }
          },
          "runAfter": {
            "Create_PR": [
              "Succeeded"
            ]
          }
        },
        "Add_comment": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-thread-comments-create",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "threadId": "@body('Create_thread')?['id']",
              "body/content": "example: bot reply",
              "body/parentCommentId": "@first(body('Create_thread')?['comments'])?['id']",
              "body/commentType": "text"
            }
          },
          "runAfter": {
            "Create_thread": [
              "Succeeded"
            ]
          }
        },
        "List_comments": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-thread-comments-list",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "threadId": "@body('Create_thread')?['id']"
            }
          },
          "runAfter": {
            "Add_comment": [
              "Succeeded"
            ]
          }
        },
        "Update_comment": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-thread-comments-update",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "threadId": "@body('Create_thread')?['id']",
              "commentId": "@body('Add_comment')?['id']",
              "body/content": "example: bot reply (edited)"
            }
          },
          "runAfter": {
            "List_comments": [
              "Succeeded"
            ]
          }
        },
        "Like_comment": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-comment-likes-create",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "threadId": "@body('Create_thread')?['id']",
              "commentId": "@body('Add_comment')?['id']"
            }
          },
          "runAfter": {
            "Update_comment": [
              "Succeeded"
            ]
          }
        },
        "List_likes": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-comment-likes-list",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "threadId": "@body('Create_thread')?['id']",
              "commentId": "@body('Add_comment')?['id']"
            }
          },
          "runAfter": {
            "Like_comment": [
              "Succeeded"
            ]
          }
        },
        "Unlike_comment": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-comment-likes-delete",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "threadId": "@body('Create_thread')?['id']",
              "commentId": "@body('Add_comment')?['id']"
            }
          },
          "runAfter": {
            "List_likes": [
              "Succeeded"
            ]
          }
        },
        "Delete_comment": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "operationId": "pull-request-thread-comments-delete",
              "connectionName": "ado-repos_#workflowname#"
            },
            "parameters": {
              "project": "",
              "repositoryId": "",
              "pullRequestId": "@body('Create_PR')?['pullRequestId']",
              "threadId": "@body('Create_thread')?['id']",
              "commentId": "@body('Add_comment')?['id']"
            }
          },
          "runAfter": {
            "Unlike_comment": [
              "Succeeded"
            ]
          }
        },
        "Cleanup_created_PR": {
          "type": "If",
          "runAfter": {
            "Create_PR": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Create_thread": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Add_comment": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "List_comments": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Update_comment": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Like_comment": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "List_likes": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Unlike_comment": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ],
            "Delete_comment": [
              "Succeeded",
              "Failed",
              "Skipped",
              "TimedOut"
            ]
          },
          "expression": "@equals(actions('Create_PR')?['status'], 'Succeeded')",
          "actions": {
            "Abandon_PR": {
              "type": "ServiceProvider",
              "inputs": {
                "serviceProviderConfiguration": {
                  "serviceProviderId": "/serviceProviders/ado-repos",
                  "operationId": "pull-requests-update",
                  "connectionName": "ado-repos_#workflowname#"
                },
                "parameters": {
                  "project": "",
                  "repositoryId": "",
                  "pullRequestId": "@body('Create_PR')?['pullRequestId']",
                  "body/status": "abandoned"
                }
              },
              "runAfter": {}
            }
          },
          "else": {
            "actions": {}
          }
        },
        "Report_result": {
          "type": "If",
          "runAfter": {
            "Cleanup_created_PR": [
              "Succeeded"
            ]
          },
          "expression": "@and(equals(actions('Create_PR')?['status'], 'Succeeded'), equals(actions('Create_thread')?['status'], 'Succeeded'), equals(actions('Add_comment')?['status'], 'Succeeded'), equals(actions('List_comments')?['status'], 'Succeeded'), equals(actions('Update_comment')?['status'], 'Succeeded'), equals(actions('Like_comment')?['status'], 'Succeeded'), equals(actions('List_likes')?['status'], 'Succeeded'), equals(actions('Unlike_comment')?['status'], 'Succeeded'), equals(actions('Delete_comment')?['status'], 'Succeeded'))",
          "actions": {
            "Result": {
              "type": "Response",
              "inputs": {
                "statusCode": 200,
                "body": {
                  "scenario": "AzureDevOpsPRDiscussionAutomation",
                  "result": "Succeeded"
                }
              },
              "runAfter": {},
              "kind": "Http"
            }
          },
          "else": {
            "actions": {
              "Scenario_failed": {
                "type": "Terminate",
                "inputs": {
                  "runStatus": "Failed",
                  "runError": {
                    "code": "ScenarioFailed",
                    "message": "A scenario step failed. Inspect its error in Monitoring; PR cleanup was attempted when creation succeeded."
                  }
                },
                "runAfter": {}
              }
            }
          }
        }
      },
      "contentVersion": "1.0.0.0",
      "outputs": {}
    }
  },
