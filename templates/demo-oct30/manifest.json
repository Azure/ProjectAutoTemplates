{
  "kind": "AutoTemplate",
  "apiVersion": "v1",
  "metadata": {
    "id": "demo-oct30",
    "name": "demo-Oct30",
    "description": "Returns today's MSN Weather forecast for the location supplied in an HTTP request.",
    "category": [
      "api"
    ],
    "tags": [],
    "author": "Microsoft",
    "source": "builtin",
    "featuredConnectors": [
      "/managedApis/msnweather",
      "connectionProviders/request"
    ]
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "triggers": {
        "When_a_HTTP_request_is_received": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "location": {
                  "type": "string",
                  "description": "Location for the weather"
                }
              }
            }
          }
        }
      },
      "actions": {
        "Get_forecast_for_today": {
          "type": "ApiConnection",
          "inputs": {
            "host": {
              "apiId": "/managedApis/msnweather",
              "operationId": "TodaysForecast",
              "connection": {
                "referenceName": "msnweather_#workflowname#"
              }
            },
            "method": "get",
            "path": "/forecast/today/${encodeURIComponent(triggerBody()?.['location'])}",
            "queries": {
              "units": "I"
            }
          },
          "metadata": {
            "swaggerPathTemplate": "/{connectionId}/forecast/today/{Location}"
          }
        },
        "Response": {
          "type": "Response",
          "inputs": {
            "statusCode": 200,
            "body": "${body('Get_forecast_for_today')}"
          },
          "runAfter": {
            "Get_forecast_for_today": [
              "SUCCEEDED"
            ]
          },
          "kind": "Http"
        }
      },
      "contentVersion": "1.0.0.0"
    }
  },
  "trigger": {
    "name": "When_a_HTTP_request_is_received",
    "outputs": {
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "queries": {},
      "body": {
        "location": "Seattle, WA"
      }
    }
  },
