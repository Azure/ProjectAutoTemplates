{
  "kind": "OttoTemplate",
  "apiVersion": "v1",
  "metadata": {
    "id": "tool-expense-report",
    "name": "Automated Expense Report Analysis and Email Summary",
    "description": "An agentic workflow that retrieves an Excel expense report, converts it to structured text using Azure AI Document Intelligence, and analyzes it with an AI agent. The agent tallies all line items, flags expenses that exceed a configurable threshold for manager approval, and sends a formatted HTML summary via email.",
    "category": [
      "ai",
      "automation"
    ],
    "tags": [
      "tool",
      "expense",
      "agent"
    ],
    "author": "Microsoft",
    "source": "builtin"
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "triggers": {
        "When_an_HTTP_request_is_received": {
          "type": "Request",
          "kind": "Http",
          "inputs": {}
        }
      },
      "actions": {
        "Convert_Excel_To_Text": {
          "type": "ApiConnection",
          "inputs": {
            "method": "post",
            "host": {
              "apiId": "/managedApis/formrecognizer",
              "operationId": "AnalyzeDocumentV40",
              "connection": {
                "referenceName": "formrecognizer_#workflowname#"
              }
            },
            "path": "/connectorinternaldocumentintelligence/documentModels/${encodeURIComponent('')}:analyze",
            "queries": {
              "api-version": "2024-11-30",
              "outputContentFormat": "markdown"
            },
            "body": "${body('Get_Expense_Report')}"
          },
          "runAfter": {
            "Get_Expense_Report": [
              "Succeeded"
            ]
          }
        },
        "Expense_Review_Agent": {
          "type": "Agent",
          "inputs": {
            "modelConfigurations": {
              "model1": {
                "referenceName": "agent_#workflowname#"
              }
            },
            "parameters": {
              "deploymentId": "gpt-4.1",
              "messages": [
                {
                  "role": "System",
                  "content": "You are an autonomous Expense Review Agent for Contoso Corp.\n\nWhen given an employee expense report, you will:\n1. Tally the total of all expense line items\n2. Flag any item over $1,000 as requiring manager approval\n3. Send an email with the summary \n\nEmail should follow this exact structure in HTML format\n\nExpense Review — [Employee Name], [Month]\n| # | Description | Category | Amount | Status |\n|---|-------------|----------|--------|--------|\n| 1 | ... | ... | $XXX.XX | OK |\n| 2 | ... | ... | $X,XXX.XX | FLAGGED — exceeds $1,000 limit |\n\nTotal Expenses Submitted: $X,XXX.XX\nItems Flagged for Approval: X item(s)\n\nIf any items flagged: The following items exceed the $1,000 threshold and require manager approval before reimbursement: [list them]\nIf no items flagged: All items are within the $1,000 limit. Report is clear for processing.\n\nRULES:\n- Do not ask clarifying questions, just process and respond\n- Flag any single line item where Amount > $1,000\n- Calculate the total accurately\n- Keep the tone professional and concise"
                },
                {
                  "role": "User",
                  "content": "Analyze this expense report ${body('Convert_Excel_To_Text')}"
                }
              ],
              "agentModelSettings": {
                "deploymentModelProperties": {
                  "name": "gpt-4.1",
                  "format": "OpenAI",
                  "version": "2025-04-14"
                },
                "agentHistoryReductionSettings": {
                  "agentHistoryReductionType": "maximumTokenCountReduction",
                  "maximumTokenCount": 128000
                }
              },
              "agentModelType": "AzureOpenAI"
            }
          },
          "runAfter": {
            "Convert_Excel_To_Text": [
              "Succeeded"
            ]
          },
          "limit": {
            "count": 60,
            "timeout": "PT1H"
          },
          "tools": {
            "Email_Expense_Report_Summary": {
              "actions": {
                "Send_Email": {
                  "type": "ApiConnection",
                  "inputs": {
                    "method": "post",
                    "host": {
                      "apiId": "/managedApis/outlook",
                      "operationId": "SendEmailV2",
                      "connection": {
                        "referenceName": "outlook_#workflowname#"
                      }
                    },
                    "path": "/v2/Mail",
                    "body": {
                      "To": "",
                      "Subject": "${agentParameters('Subject')}",
                      "Body": "<p class=\"editor-paragraph\">${agentParameters('Body')}</p>",
                      "Importance": "Normal"
                    }
                  }
                }
              },
              "description": "Use this tool to email expense report summary ",
              "agentParameterSchema": {
                "type": "object",
                "properties": {
                  "Subject": {
                    "type": "string",
                    "description": "Specify the subject of the mail"
                  },
                  "Body": {
                    "type": "string",
                    "description": "Specify the body of the mail"
                  }
                }
              }
            }
          }
        },
        "Get_Expense_Report": {
          "type": "Http",
          "inputs": {
            "uri": "",
            "method": "GET"
          }
        }
      },
      "contentVersion": "1.0.0.0"
    }
  },
  "trigger": {
