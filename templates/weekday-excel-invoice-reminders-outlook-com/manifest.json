            },
            {
              "Invoice Number": "INV-1002",
              "Customer Name": "Blair Chen",
              "Customer Email": "blair@example.com",
              "Due Date": "2026-09-23",
              "Amount": "$480.00",
              "Payment Status": "Pending"
            },
            {
              "Invoice Number": "INV-1003",
              "Customer Name": "Casey Morgan",
              "Customer Email": "casey@example.com",
              "Due Date": "2026-09-26T09:00:00-07:00",
              "Amount": "$725.00",
              "Payment Status": "Open"
            },
            {
              "Invoice Number": "INV-1004",
              "Customer Name": "Devon Reed",
              "Customer Email": "devon@example.com",
              "Due Date": "2026-09-23",
              "Amount": "$315.00",
              "Payment Status": "  pAiD  "
            },
            {
              "Invoice Number": "INV-1005",
              "Customer Name": "Emery Patel",
              "Customer Email": "   ",
              "Due Date": "2026-09-23",
              "Amount": "$940.00",
              "Payment Status": "Unpaid"
            },
            {
              "Invoice Number": "INV-1006",
              "Customer Name": "Finley Ross",
