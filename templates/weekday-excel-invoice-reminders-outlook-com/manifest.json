            }
          ]
        }
      }
    },
    "Send_invoice_reminder": {
      "status": "Succeeded",
      "outputs": {
        "statusCode": "200",
        "headers": {},
        "body": {}
      }
    }
  },
  "connections": {
    "excel-online-business_#workflowname#": {
      "connectorType": "shared",
      "apiId": "/managedApis/excelonlinebusiness"
    },
    "outlook-com_#workflowname#": {
      "connectorType": "shared",
      "apiId": "/managedApis/outlook"
    }
  }
}
