                }
              }
            },
            {
              "id": 203,
              "state": "completed",
              "result": "failed",
              "pipeline": {
                "id": 42,
                "name": "example-pipeline"
              },
              "url": "https://dev.azure.com/example/ExampleProject/_apis/pipelines/42/runs/203",
              "_links": {
                "web": {
                  "href": "https://dev.azure.com/example/ExampleProject/_build/results?buildId=203"
                }
              }
            },
            {
              "id": 202,
              "state": "completed",
              "result": "failed",
              "pipeline": {
                "id": 42,
                "name": "example-pipeline"
              },
              "url": "https://dev.azure.com/example/ExampleProject/_apis/pipelines/42/runs/202",
              "_links": {
                "web": {
                  "href": "https://dev.azure.com/example/ExampleProject/_build/results?buildId=202"
                }
              }
            },
            {
              "id": 201,
              "state": "completed",
              "result": "succeeded",
              "pipeline": {
                "id": 42,
                "name": "example-pipeline"
              },
              "url": "https://dev.azure.com/example/ExampleProject/_apis/pipelines/42/runs/201",
              "_links": {
                "web": {
                  "href": "https://dev.azure.com/example/ExampleProject/_build/results?buildId=201"
                }
              }
            }
          ]
        }
      }
    },
    "Find_tracking_task": {
      "status": "Succeeded",
      "outputs": {
        "statusCode": "OK",
        "body": {
