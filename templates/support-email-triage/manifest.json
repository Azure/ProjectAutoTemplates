{
  "kind": "AutoTemplate",
  "apiVersion": "v1",
  "metadata": {
    "id": "support-email-triage",
    "name": "Support Email Triage with Teams Escalation and SharePoint Logging",
    "description": "Fetches a support email and automatically escalates urgent messages to a Microsoft Teams channel. All incoming emails are logged to a SharePoint list for tracking.",
    "category": ["automation"],
    "tags": [
      "email",
      "support",
      "teams",
      "sharepoint"
    ],
    "author": "Microsoft",
    "source": "builtin",
    "featuredConnectors": [
      "/managedApis/office365",
      "/managedApis/teams",
      "/managedApis/sharepointonline"
    ]
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "triggers": {
        "Run_triage_for_an_email": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "schema": {
              "type": "object",
              "properties": {
                "messageId": { "type": "string" }
              }
            }
          }
        }
      },
      "actions": {
        "Get_email": {
          "type": "ApiConnection",
          "inputs": {
            "method": "get",
            "host": {
              "apiId": "/managedApis/office365",
              "operationId": "GetEmailV2",
              "connection": {
                "referenceName": "office365_#workflowname#"
              }
            },
            "path": "/v2/Mail/${encodeURIComponent(triggerBody()?.['messageId'])}"
          },
          "metadata": {
            "swaggerPathTemplate": "/{connectionId}/v2/Mail/{messageId}"
          },
          "runAfter": {}
        },
        "IsUrgent": {
          "type": "If",
          "expression": "${contains(coalesce(body('Get_email')?.['subject'], ''), 'URGENT')}",
          "actions": {
            "Notify_team": {
              "type": "ApiConnection",
              "inputs": {
                "method": "post",
                "host": {
                  "apiId": "/managedApis/teams",
                  "operationId": "PostMessageToConversation",
                  "connection": {
                    "referenceName": "teams_#workflowname#"
                  }
                },
                "path": "/beta/teams/conversation/message/poster/${encodeURIComponent('Flow bot')}/location/${encodeURIComponent('Channel')}",
                "body": {
                  "recipient": {
                    "groupId": "",
                    "channelId": ""
                  },
                  "messageBody": "<p class=\"editor-paragraph\"><span style=\"color: rgb(165, 214, 255); white-space: pre-wrap;\">High priority ticket needs attention. Here are the details shared by the customer:</span></p><p class=\"editor-paragraph\">${body('Get_email')?.['body']}</p>"
                }
              },
              "metadata": {
                "swaggerPathTemplate": "/{connectionId}/beta/teams/conversation/message/poster/{poster}/location/{location}"
              }
            }
          },
          "else": {
            "actions": {
              "NonUrgentAck": {
                "type": "Compose",
                "inputs": {
                  "status": "received-not-urgent",
                  "subject": "${body('Get_email')?.['subject']}",
                  "sender": "${coalesce(body('Get_email')?.['from'], body('Get_email')?.['sender'], 'Unknown')}"
                }
              }
            }
          },
          "runAfter": {
            "Get_email": [
              "Succeeded"
            ]
          }
        },
        "Log_support_ticket": {
          "type": "ApiConnection",
          "inputs": {
            "method": "post",
            "host": {
              "apiId": "/managedApis/sharepointonline",
              "operationId": "PostItem",
              "connection": {
                "referenceName": "sharepointonline_#workflowname#"
              }
            },
            "path": "/datasets//tables//items",
            "body": {
              "Title": "${body('Get_email')?.['bodyPreview']}",
              "Subject": "${body('Get_email')?.['subject']}",
              "Sender": "${body('Get_email')?.['toRecipients']}",
              "InternetMessageId": "${body('Get_email')?.['id']}",
              "ReceivedAt": "${body('Get_email')?.['receivedDateTime']}",
              "TriggerRunId": "1"
            }
          },
          "runAfter": {
            "IsUrgent": [
              "Succeeded"
            ]
          },
          "metadata": {
            "swaggerPathTemplate": "/{connectionId}/datasets/{dataset}/tables/{table}/items"
          }
        }
      },
      "contentVersion": "1.0.0.0"
    }
  },
  "trigger": {
    "name": "Run_triage_for_an_email",
    "outputs": {
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "queries": {},
      "body": {
        "messageId": "a1b2c3d4-e5f6-7890-abcd-ef1234567890"
      }
    }
  },
  "mocks": {
    "Get_email": {
      "status": "Succeeded",
      "outputs": {
        "statusCode": "200",
        "body": {
          "from": "user@contoso.com",
          "toRecipients": "support@contoso.com",
          "subject": "URGENT support request",
          "body": "Please help with order issue",
          "bodyPreview": "Please help with order issue",
          "importance": "high",
          "hasAttachments": false,
          "id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
          "receivedDateTime": "2026-06-15T21:43:00Z"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "Notify_team": {
      "status": "Succeeded",
      "outputs": {
        "statusCode": "201",
        "body": {
          "id": "1781559824182",
          "messageLink": "https://teams.microsoft.com/l/message/19:example@thread.skype/1781559824182",
          "conversationId": "19:example@thread.skype"
        },
        "headers": {
          "Content-Type": "application/json"
        }
      }
    },
    "NonUrgentAck": {
      "runForReal": true
    },
    "Log_support_ticket": {
      "status": "Succeeded",
      "outputs": {
        "statusCode": "201",
        "body": {
          "ItemInternalId": "11",
          "ID": 11,
          "Title": "URGENT 10",
          "Subject": "URGENT 10",
          "Sender": "user@contoso.com",
          "ReceivedAt": "2026-06-15",
          "TriggerRunId": "1",
          "Modified": "2026-06-15T21:43:54Z",
          "Created": "2026-06-15T21:43:54Z"
        },
        "headers": {
          "Content-Type": "application/json; charset=utf-8"
        }
      }
    }
  },
  "connections": {
    "office365_#workflowname#": {
      "connectorType": "shared",
      "apiId": "/managedApis/office365"
    },
    "teams_#workflowname#": {
      "connectorType": "shared",
      "apiId": "/managedApis/teams"
    },
    "sharepointonline_#workflowname#": {
      "connectorType": "shared",
      "apiId": "/managedApis/sharepointonline"
    }
  }
}
