{
  "kind": "AutoTemplate",
  "apiVersion": "v1",
  "metadata": {
    "id": "scenario-04-wiql-query-reporting",
    "name": "Run a saved Azure DevOps Boards WIQL query every hour",
    "description": "Every hour, list saved queries in the configured Azure DevOps Boards project, retrieve a selected query, and run it to return matching work item references. Configure the Boards connection, project, team, and saved query before publishing.",
    "category": [
      "engineering",
      "data"
    ],
    "tags": [
      "Azure DevOps",
      "Boards",
      "WIQL",
      "Reporting",
      "Saved queries"
    ],
    "author": "Microsoft",
    "source": "builtin",
    "featuredConnectors": [
      "/serviceProviders/ado-boards"
    ]
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "triggers": {
        "Recurrence": {
          "type": "Recurrence",
          "recurrence": {
            "frequency": "Hour",
            "interval": 1
          }
        }
      },
      "actions": {
        "List_saved_queries": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-boards",
              "operationId": "queries-list",
              "connectionName": "ado-boards_#workflowname#"
            },
            "parameters": {
              "project": "",
              "$depth": 2
            }
          },
          "runAfter": {}
        },
        "Get_a_saved_query": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-boards",
              "operationId": "queries-get",
              "connectionName": "ado-boards_#workflowname#"
            },
            "parameters": {
              "project": "",
              "query": "",
              "$depth": 2,
              "$includeDeleted": true,
              "$useIsoDateFormat": true
            }
          },
          "runAfter": {
            "List_saved_queries": [
              "Succeeded"
            ]
          }
        },
        "Run_a_saved_WIQL_query": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-boards",
              "operationId": "wiql-query-by-id",
              "connectionName": "ado-boards_#workflowname#"
            },
            "parameters": {
              "project": "",
              "team": "",
              "id": "",
              "timePrecision": true
            }
          },
          "runAfter": {
            "Get_a_saved_query": [
              "Succeeded"
            ]
          }
        }
      },
      "contentVersion": "1.0.0.0"
    }
  },
  "trigger": {
    "name": "Recurrence",
    "outputs": {
      "method": "POST",
      "headers": {},
      "queries": {},
      "body": null
    }
  },
