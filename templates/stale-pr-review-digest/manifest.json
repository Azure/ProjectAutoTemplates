{
  "kind": "AutoTemplate",
  "apiVersion": "v1",
  "metadata": {
    "id": "stale-pr-review-digest",
    "name": "Stale PR Review Digest",
    "description": "Find open Azure DevOps pull requests older than a chosen number of days. Generate a digest with PR links, authors, creation dates, and draft status to help your team prioritize review follow-ups.",
    "category": [
      "engineering",
      "communication"
    ],
    "tags": [
      "Azure DevOps",
      "Repos",
      "Pull requests",
      "Digest"
    ],
    "author": "Microsoft",
    "source": "builtin",
    "featuredConnectors": [
      "/serviceProviders/ado-repos",
      "connectionProviders/request"
    ]
  },
  "workflow": {
    "definition": {
      "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
      "triggers": {
        "When_an_HTTP_request_is_received": {
          "type": "Request",
          "kind": "Http",
          "inputs": {
            "schema": {
              "type": "object",
              "required": [
                "project",
                "repositoryId",
                "staleAfterDays"
              ],
              "properties": {
                "project": {
                  "type": "string",
                  "title": "Azure DevOps project",
                  "example": "ExampleProject",
                  "minLength": 1
                },
                "repositoryId": {
                  "type": "string",
                  "title": "Repository ID",
                  "example": "22222222-2222-4222-8222-222222222222",
                  "minLength": 1
                },
                "staleAfterDays": {
                  "type": "integer",
                  "title": "PR creation age in days",
                  "example": 7,
                  "minimum": 1,
                  "maximum": 3650
                }
              }
            }
          },
          "description": "Read-only. Enter project, repository and age in days. Returns older open PRs for review follow-up; does not post comments or modify PRs."
        }
      },
      "actions": {
        "Find_older_active_PRs": {
          "type": "ServiceProvider",
          "inputs": {
            "serviceProviderConfiguration": {
              "serviceProviderId": "/serviceProviders/ado-repos",
              "connectionName": "ado-repos_#workflowname#",
              "operationId": "pull-requests-list"
            },
            "parameters": {
              "project": "@triggerBody()?['project']",
              "repositoryId": "@triggerBody()?['repositoryId']",
              "searchCriteria.status": "active",
              "searchCriteria.maxTime": "@addDays(utcNow(),sub(0,triggerBody()?['staleAfterDays']))",
              "searchCriteria.queryTimeRangeType": "created",
              "$top": 100
            }
          },
          "runAfter": {},
          "description": "Lists up to 100 open PRs created before the age cutoff. This is age-based triage, not a claim that the PR has had no recent activity."
        },
        "Format_PR_digest": {
          "type": "Select",
          "inputs": {
            "from": "@body('Find_older_active_PRs')?['value']",
            "select": "@concat('- [PR ',string(item()?['pullRequestId']),'](',item()?['repository']?['webUrl'],'/pullrequest/',string(item()?['pullRequestId']),') ',item()?['title'],' | ',item()?['createdBy']?['displayName'],' | created ',item()?['creationDate'],if(equals(item()?['isDraft'],true),' | Draft',''))"
          },
          "runAfter": {
            "Find_older_active_PRs": [
              "Succeeded"
            ]
          },
          "description": "Shows a link, title, author, creation date and draft flag for every matching PR."
        },
        "Prepare_report": {
          "type": "Compose",
          "inputs": {
            "title": "Stale PR Review Digest",
            "count": "@length(body('Find_older_active_PRs')?['value'])",
            "pullRequests": "@body('Find_older_active_PRs')?['value']",
            "mayBeTruncated": "@greaterOrEquals(length(body('Find_older_active_PRs')?['value']),100)",
            "markdown": "@concat('# Stale PR Review Digest',decodeUriComponent('%0A%0A'),'Open PRs at least ',string(triggerBody()?['staleAfterDays']),' days old (creation age, not inactivity).',decodeUriComponent('%0A%0A'),if(empty(body('Format_PR_digest')),'No open PRs matched the age cutoff.',join(body('Format_PR_digest'),decodeUriComponent('%0A'))),if(greaterOrEquals(length(body('Find_older_active_PRs')?['value']),100),concat(decodeUriComponent('%0A%0A'),'Warning: the 100-PR limit was reached; this digest may be incomplete.'),''))"
          },
          "runAfter": {
            "Format_PR_digest": [
              "Succeeded"
            ]
          },
          "description": "Ready to share with the team. A limit warning prevents a capped digest from looking complete."
        },
        "Return_report": {
          "type": "Response",
          "inputs": {
            "statusCode": 200,
            "headers": {
              "Content-Type": "application/json"
            },
            "body": "@outputs('Prepare_report')"
          },
          "runAfter": {
            "Prepare_report": [
              "Succeeded"
            ]
          },
          "description": "Returns a readable Markdown summary plus structured details. Failed reads fail the run; they are not reported as empty results."
        }
      },
      "contentVersion": "1.0.0.0",
      "outputs": {}
    }
  },
  "trigger": {
    "name": "When_an_HTTP_request_is_received",
    "outputs": {
      "method": "POST",
      "headers": {
        "Content-Type": "application/json"
      },
      "queries": {},
      "body": {
        "project": "ExampleProject",
        "repositoryId": "22222222-2222-4222-8222-222222222222",
        "staleAfterDays": 7
      }
    }
  },
  "mocks": {
    "Find_older_active_PRs": {
      "status": "Succeeded",
      "outputs": {
        "statusCode": "OK",
        "body": {
          "count": 1,
          "value": [
            {
              "repository": {
                "id": "22222222-2222-4222-8222-222222222222",
                "name": "example-repo",
                "project": {
                  "id": "11111111-1111-4111-8111-111111111111",
                  "name": "ExampleProject"
                },
                "url": "https://dev.azure.com/example/ExampleProject/_apis/git/repositories/22222222-2222-4222-8222-222222222222",
                "webUrl": "https://dev.azure.com/example/ExampleProject/_git/example-repo"
              },
              "pullRequestId": 1,
              "status": "active",
              "createdBy": {
                "id": "33333333-3333-4333-8333-333333333333",
                "displayName": "Example Developer",
                "uniqueName": "developer@example.com"
              },
              "creationDate": "2026-01-01T12:00:00Z",
              "title": "Update example documentation",
              "description": "Synthetic pull request for draft testing.",
              "sourceRefName": "refs/heads/docs/example",
              "targetRefName": "refs/heads/main",
              "mergeStatus": "succeeded",
              "isDraft": false,
              "url": "https://dev.azure.com/example/ExampleProject/_apis/git/repositories/22222222-2222-4222-8222-222222222222/pullRequests/1"
            }
          ]
        }
      }
    }
  },
  "connections": {
    "ado-repos_#workflowname#": {
      "connectorType": "inapp",
      "apiId": "/serviceProviders/ado-repos"
    }
  }
}
